# Chép file này thành .env rồi điền giá trị thật.
#   Copy-Item .env.example .env
# File .env đã được gitignore — KHÔNG commit, KHÔNG dán nội dung vào chat.
# Dòng nào chưa điền (còn dấu <>) sẽ bị bỏ qua, không gây lỗi.


# ─── 1. Gemini ────────────────────────────────────────────────────────────
# Lấy miễn phí, KHÔNG cần thẻ tín dụng, KHÔNG cần project GCP:
#   https://aistudio.google.com/apikey  ->  Create API key
# Có free tier, spike vài file gần như chắc chắn không tốn tiền.
GEMINI_API_KEY=<AIza...>


# ─── 2. Document AI ───────────────────────────────────────────────────────
# Chỉ cần nếu muốn chạy các luồng có OCR của Google.
# Bỏ trống hết thì vẫn chạy được luồng gemini_direct.

# Project ID (KHÔNG phải tên hiển thị, KHÔNG phải project number).
# Xem ở https://console.cloud.google.com/  ->  ô chọn project, cột "ID"
DOCAI_PROJECT=<vd: recon-platform-471203>

# Vùng đặt processor: us hoặc eu. PHẢI trùng vùng lúc tạo processor.
DOCAI_LOCATION=us

# Xác thực. Cách 1 (khuyến nghị, không có file key để lộ):
#   gcloud auth application-default login
# rồi để trống dòng dưới.
# Cách 2: tải file key service account JSON rồi điền đường dẫn tuyệt đối.
GOOGLE_APPLICATION_CREDENTIALS=<C:\duong\dan\sa-key.json>


# ─── 3. Processor ID ──────────────────────────────────────────────────────
# Tạo tại https://console.cloud.google.com/ai/document-ai/processor-library
# Mỗi loại bấm Create một lần, xong copy phần ID (chuỗi hex ~16 ký tự).
# Tạo cái nào thì điền cái đó — không cần đủ cả ba.

# "Form Parser"          $30/1.000 trang  -> luồng formparser_*  (đang dùng ở production)
DOCAI_PROCESSOR_ID=<id form parser>

# "Document OCR"         $1,50/1.000 trang -> luồng dococr_gemini
DOCAI_OCR_PROCESSOR_ID=<id document ocr>

# "Layout Parser"        $10/1.000 trang  -> luồng layout_gemini
DOCAI_LAYOUT_PROCESSOR_ID=<id layout parser>


# ─── 4. Amazon Textract (tuỳ chọn — chỉ để ĐỐI CHỨNG) ────────────────────
#
# ĐỌC KỸ TRƯỚC KHI DÙNG: Textract KHÔNG hỗ trợ tiếng Việt. Tài liệu AWS chỉ
# liệt kê English, French, German, Italian, Portuguese, Spanish:
#   https://docs.aws.amazon.com/textract/latest/dg/limits-document.html
# Document AI đo được 99,5% dấu tiếng Việt trên chứng từ thật (FINDINGS.md).
# Hai luồng textract_* có mặt để TRẢ LỜI BẰNG SỐ ĐO câu "sao không dùng AWS
# cho đồng bộ", không phải để thay Document AI.
#
# Cần credential AWS (aws configure) và MỘT BUCKET S3 THẬT: Textract async chỉ
# đọc file từ S3, không nhận bytes — mà file ở đây nằm trên ổ đĩa.
# Tạo bucket:  aws s3 mb s3://ten-bucket-cua-ngai --region ap-southeast-1
TEXTRACT_S3_BUCKET=<ten bucket s3 that>

# Region chạy Textract. Giá bên dưới lấy ở us-west-2 — KIỂM LẠI nếu đổi region.
# AWS_REGION=ap-southeast-1


# ─── 5. Đơn giá (chỉ đổi khi nhà cung cấp đổi bảng giá) ──────────────────
# GEMINI_INPUT_USD_PER_1M=0.30
# GEMINI_OUTPUT_USD_PER_1M=2.50
# DOCAI_USD_PER_PAGE=0.030
# DOCAI_OCR_USD_PER_PAGE=0.0015
# DOCAI_LAYOUT_USD_PER_PAGE=0.010
# TEXTRACT_USD_PER_PAGE=0.0015           DetectDocumentText
# TEXTRACT_ANALYZE_USD_PER_PAGE=0.065    AnalyzeDocument FORMS+TABLES (+LAYOUT free)
