# opencode config cá nhân
opencode.json
AGENTS.md

# Credential — KHÔNG BAO GIỜ commit
.env
*/.env
evaluation/results/

# Dataset đánh giá — dữ liệu bên thứ ba (MC-OCR) và chứng từ thật của doanh
# nghiệp, không phân phối lại qua repo. Nguồn tải: evaluation/README.md
evaluation/dataset/documents/*
evaluation/dataset/ground_truth/*
!evaluation/dataset/**/.gitkeep

# Service account key Google (nên để NGOÀI repo, đây chỉ là lưới an toàn)
*sa-key*.json
*service-account*.json
*credentials*.json
gcp-key*.json

# Python
.venv/
__pycache__/
.pytest_cache/
*.pyc

# Terraform (bin/ = binary tải về, không commit; .terraform.lock.hcl thì CÓ commit)
infra/bin/
infra/.terraform/
infra/bootstrap/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/bootstrap/*.tfstate*
infra/backend.hcl
infra/*.tfvars
!infra/dev.tfvars.example
infra/artifacts/
# File plan CHỨA giá trị biến sensitive (gemini_api_key, khoá service account
# Google). Terraform nén plan thành zip nên `grep` KHÔNG thấy key — đừng lấy đó
# làm bằng chứng là an toàn. Dấu `*` cuối để bắt cả `tfplan2`, `tfplan.bak`...
infra/tfplan*
infra/*.tfplan*
infra/bootstrap/*.tfplan*
infra/plan.json
infra/build/

# Log của terraform/devserver: chứa ARN, account id, đường dẫn máy cá nhân
infra/*.log
backend/*.log

# Biến môi trường frontend: giữ .env.example, chặn mọi bản thật/bản lưu tạm
frontend/.env
frontend/.env.*
!frontend/.env.example

# Rác của công cụ chạy thử
.codex-*.json