# Đổi khi backend chạy ở nơi khác (mặc định là dev server)
VITE_API_URL=http://127.0.0.1:8000

# Cognito (để trống = chỉ bypass khi VITE_API_URL là localhost; env=dev trên AWS vẫn yêu cầu JWT)
# Lấy từ terraform output: cognito_user_pool_id / cognito_client_id
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_AWS_REGION=ap-southeast-1
